# ── Claude (Anthropic) API ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Naver Search API (뉴스 검색, 선택 사항) ─────────────────────────────────────
# https://developers.naver.com/apps 에서 발급
# 비워두면 자동으로 RSS 피드(src/news/fetcher.py의 RSS_FEEDS)로 뉴스를 수집하므로
# 반드시 필요하지는 않음. 애플리케이션 등록 시 "검색" API가 목록에 없을 수 있는데,
# 이 경우 네이버 측에 문의하고 그동안은 RSS만으로 운영 가능.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── Tistory Blog API ───────────────────────────────────────────────────────────
# https://www.tistory.com/guide/api 에서 발급
TISTORY_ACCESS_TOKEN=your_tistory_access_token
TISTORY_BLOG_NAME=your_tistory_blog_name     # e.g. myblog (myblog.tistory.com)

# ── Instagram Graph API ────────────────────────────────────────────────────────
# Meta Developer → Instagram Basic Display 또는 Graph API
# 비즈니스 계정 + Facebook Page 연결 필요
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id  # Instagram Business Account ID

# ── Threads API ────────────────────────────────────────────────────────────────
# Meta Developer → Threads API (threads_basic, threads_content_publish 권한)
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# ── Facebook Page Graph API ─────────────────────────────────────────────────────
# Meta Developer → 페이지 액세스 토큰 (pages_manage_posts, pages_read_engagement)
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# ── Imgbb (이미지 호스팅) ─────────────────────────────────────────────────────────
# https://imgbb.com/api — Instagram/Threads/블로그 이미지 삽입 시 공개 URL 발급용
IMGBB_API_KEY=your_imgbb_api_key

# ── 스케줄 설정 (KST 기준) ─────────────────────────────────────────────────────
# "초안" 생성 시각 (쉼표 구분, 24h 형식). 실제 발행은 담당자가 --publish로 별도 승인.
SCHEDULE_HOURS=8,12,18,21

# ── 검색 키워드 설정 ────────────────────────────────────────────────────────────
# 참고: 실제 뉴스 검색 범위는 src/news/fetcher.py의 NATIONAL_QUERIES(전국)와
# GWANAK_QUERIES(관악구 우선순위)로 관리됨. 아래 값은 --test 확인용 참고 정보.
KEYWORDS=부동산,관악구,아파트,전세,월세,분양,재개발,재건축

# ── 콘텐츠 저장 디렉토리 ────────────────────────────────────────────────────────
OUTPUT_DIR=./output
