{
  "name": "RSAR Land3 매통이 (매물·통화 자동정리)",
  "short_name": "매통이",
  "description": "부동산 통화 녹음을 AI가 매물 접수·고객 상담 카드로 자동 정리",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0160f0",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "video/3gpp", ".m4a", ".mp3", ".amr", ".aac", ".ogg", ".wav", ".3gp", ".opus"]
        }
      ]
    }
  }
}
