[Unit]
Description=Mr. Homes GA — 관악구 부동산 뉴스 자동 포스팅
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/mrhomesga
EnvironmentFile=/path/to/mrhomesga/.env
ExecStart=/usr/bin/python3 /path/to/mrhomesga/main.py
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
